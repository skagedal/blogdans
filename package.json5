// JSON5 manifest instead of package.json, so we can write comments like this one.
// pnpm/action-setup doesn't read the packageManager field from package.json5 yet, so CI
// uses a fork that does until https://github.com/pnpm/action-setup/pull/290 lands.
{
  "name": "blogdans",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db": "kysely-codegen --out-file src/db/schema.d.ts",
    "test": "vitest",
    "test:run": "vitest run",
  },
  "dependencies": {
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-toast": "latest",
    "@slack/webhook": "latest",
    "@tanstack/react-query": "latest",
    "@trpc/client": "latest",
    "@trpc/next": "latest",
    "@trpc/server": "latest",
    "@trpc/tanstack-react-query": "latest",
    "better-auth": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "gray-matter": "latest",
    "kysely": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "nodemailer": "latest",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "latest",
    "react-markdown": "latest",
    "rehype-highlight": "latest",
    "rehype-raw": "latest",
    "rehype-sanitize": "latest",
    "rehype-stringify": "latest",
    "remark-gfm": "latest",
    "remark-parse": "latest",
    "remark-rehype": "latest",
    "superjson": "latest",
    "tailwind-merge": "latest",
    "unified": "latest",
    "winston": "latest",
    "zod": "latest",
  },
  "devDependencies": {
    // Next's rules on their own, rather than eslint-config-next, which also
    // bundles eslint-plugin-react, eslint-plugin-import and
    // eslint-plugin-jsx-a11y. All three cap their eslint peer at 9, and
    // eslint-plugin-react crashes outright on 10. Next documents this split
    // under "Using the plugin directly"; nothing Next-specific is lost, the
    // plugin ships every rule and both presets.
    "@eslint-react/eslint-plugin": "latest",
    "@next/eslint-plugin-next": "latest",
    "@tailwindcss/postcss": "latest",
    "@tailwindcss/typography": "latest",
    "@testcontainers/postgresql": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript/native": "npm:typescript@^7",
    "@vitest/browser": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/ui": "latest",
    "dbmate": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "kysely-codegen": "latest",
    "playwright": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "testcontainers": "latest",
    "typescript-eslint": "latest",
    // typescript-eslint doesn't support real TS 7 yet (github.com/typescript-eslint/typescript-eslint/issues/10940),
    // since TS 7.0 ships without a stable programmatic API. So "typescript" resolves to the
    // 6.0 API compat shim for tooling, while @typescript/native provides the real, fast TS 7
    // compiler as the `tsc` binary.
    "typescript": "npm:@typescript/typescript6@^6",
    "uuid": "latest",
    "vitest": "latest",
    "vitest-browser-react": "latest",
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
}
